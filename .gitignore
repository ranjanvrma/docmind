# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# User data (uploaded PDFs, indexes, registry) - never commit uploaded documents
data/raw/*
data/processed/*
data/index/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/index/.gitkeep
data/classifier/*.joblib
data/classifier/*.report.json

# Evaluation outputs (regenerate with python evaluation/evaluate.py)
evaluation/results/*
!evaluation/results/.gitkeep

# Notebooks / editors / OS
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local Claude Code tooling
.claude/
