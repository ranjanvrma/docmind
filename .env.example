# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- LLM (only needed for the "Ask a question" / POST /ask feature) ---------
# anthropic -> Anthropic Messages API (official SDK)
# openai    -> any OpenAI-compatible /chat/completions API (OpenAI, Groq, Together,
#              OpenRouter, a local Ollama server, ...). Set LLM_BASE_URL for non-OpenAI hosts.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_BASE_URL=http://localhost:11434/v1        # Ollama (any non-empty LLM_API_KEY works)
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Upper bound on retrieved text sent to the LLM per question (characters)
MAX_CONTEXT_CHARS=6000

# --- Embeddings ---------------------------------------------------------------
# Changing the model requires re-processing documents (the index stores the model name
# and refuses to load with a different one).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking / retrieval -----------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5

# --- Ingestion ----------------------------------------------------------------
MAX_UPLOAD_MB=25
MIN_CHARS_PER_PAGE=20

# --- Classification -----------------------------------------------------------
CLASSIFIER_LABELS=Research Paper,Report,Assignment,Notes,Policy,Other

# --- Misc ---------------------------------------------------------------------
LOG_LEVEL=INFO
# DATA_DIR=./data
# Used by the Streamlit frontend to find the API
DOCMIND_API_URL=http://127.0.0.1:8000
