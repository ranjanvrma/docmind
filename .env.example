# DocMind configuration. Copy to .env and fill in:  cp .env.example .env
# .env is git-ignored and docker-ignored. Never commit real keys.
# Every value below is optional except where marked; blank = use the default.

# --- LLM (required only for "Ask a question" / POST /ask) ------------------------
# $0 setup: OpenRouter's free models through its OpenAI-compatible API.
# Create a key at https://openrouter.ai/keys (free models need no credit).
#   openrouter/free routes each request to one of the currently free models.
#   DocMind checks every answer's citations and retries once if a routed model
#   ignores the rules, so routing works; pin a concrete model ID (for example
#   nvidia/nemotron-3-super-120b-a12b:free) if you prefer predictable behaviour.
LLM_PROVIDER=openai
# Secret. Without it, search and classification still work and /ask returns 503.
LLM_API_KEY=
LLM_MODEL=openrouter/free
LLM_BASE_URL=https://openrouter.ai/api/v1
# Alternatives:
#   Anthropic:  LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5  (LLM_BASE_URL unused)
#   Ollama:     LLM_PROVIDER=openai     LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=<local model>
# Upper bound on the response, including any model "thinking" tokens.
LLM_MAX_TOKENS=8192
# Anthropic only: low | medium | high | xhigh | max. Blank = model default.
# "low" or "medium" is usually enough for grounded Q&A and is cheaper/faster.
# Leave blank for models that do not support effort (e.g. claude-haiku-4-5).
LLM_EFFORT=
# OpenAI-compatible provider only (the Anthropic client does not send it).
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
# Upper bound on retrieved text sent to the LLM per question (characters).
MAX_CONTEXT_CHARS=6000
# Passages whose cosine similarity to the question is below this are not sent to
# the LLM; if none pass, DocMind abstains without calling it (0 disables).
MIN_RELEVANCE=0.15

# --- API access (set these before exposing the API beyond your own machine) -----
# Secret. Administrator token for /api/admin/* (server settings, LLM test,
# evaluation lab, diagnostics), sent as "X-API-Key: <token>" or
# "Authorization: Bearer <token>". Visitors never need it: they use the app
# anonymously, each browser with its own private session. Required (>= 24
# characters) when APP_ENV=production.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DOCMIND_API_TOKEN=
# Comma-separated browser origins allowed to call the API directly (CORS).
# Leave blank for the bundled web UI, which is served from the same origin
# (required for visitor sessions, whose cookie is same-site only).
# Exact origins only (no "*", no trailing slash).
# Example: CORS_ALLOW_ORIGINS=https://docmind.example.com
CORS_ALLOW_ORIGINS=

# --- Public visitors (anonymous use) ---------------------------------------------
# Limits apply per client IP and per browser session; 0 disables a limit.
# The limiter is in-process: correct for one instance (e.g. Render free), not
# sufficient on its own if you run several instances.
# PUBLIC_RATE_LIMIT=120               # API requests per PUBLIC_RATE_WINDOW_SECONDS
# PUBLIC_RATE_WINDOW_SECONDS=60
# PUBLIC_QA_RATE_LIMIT=20             # questions per PUBLIC_QA_RATE_WINDOW_SECONDS
# PUBLIC_QA_RATE_WINDOW_SECONDS=3600
# PUBLIC_QA_GLOBAL_LIMIT=200          # questions per window for all visitors together (protects the LLM key)
# PUBLIC_UPLOAD_RATE_LIMIT=20         # files per PUBLIC_UPLOAD_RATE_WINDOW_SECONDS
# PUBLIC_UPLOAD_RATE_WINDOW_SECONDS=3600
# PUBLIC_MAX_DOCUMENTS=20             # documents a visitor can keep at once
# PUBLIC_MAX_ACTIVE_JOBS=5            # documents a visitor can have queued/processing at once
# PUBLIC_MAX_SESSIONS=1000            # active visitor sessions on the server
# PUBLIC_NEW_SESSIONS_PER_IP=20       # new sessions per IP per hour (stops cookie-dropping)
# SESSION_TTL_HOURS=24                # idle sessions and their documents are deleted after this
# SESSION_COOKIE_NAME=docmind_session
# Reverse proxies in front of the app that append to X-Forwarded-For. 0 = use
# the TCP peer address. Render: 1. Check with GET /api/admin/diagnostics
# ("client_ip" should be your own IP). Too high a value lets clients spoof IPs.
# TRUSTED_PROXY_COUNT=0

# --- Deployment ------------------------------------------------------------------
# development (default for `python main.py api`) | production (default in the Docker
# image; leave this commented out there). "production" refuses to start without
# a DOCMIND_API_TOKEN of 24+ characters and hides the interactive API docs.
# APP_ENV=production
# Serve /api/docs and /api/openapi.json (default: true in development, false in production).
# API_DOCS=false
# Bind address and port for `python main.py api` (cloud platforms usually set PORT).
# HOST=127.0.0.1
# PORT=8000

# --- Embeddings ------------------------------------------------------------------
# Changing the model requires re-processing documents (the index stores the model
# name and refuses to load with a different one). In Docker, rebuild with
# --build-arg EMBEDDING_MODEL=... instead.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking / retrieval --------------------------------------------------------
# At most 1200: the embedding model reads only ~256 tokens per chunk.
CHUNK_SIZE=600
CHUNK_OVERLAP=150
TOP_K=5

# --- Upload / processing limits --------------------------------------------------
# Per-file limit (also shown in the UI).
MAX_UPLOAD_MB=25
# Whole upload request (all files). Larger requests get HTTP 413 before the body is read.
MAX_REQUEST_MB=100
# Documents with more pages are rejected at processing time.
MAX_PAGES=500
MIN_CHARS_PER_PAGE=20

# --- Classification --------------------------------------------------------------
# Used by the zero-shot classifier. A trained classifier uses its own training labels.
CLASSIFIER_LABELS=Research Paper,Report,Assignment,Notes,Policy,Other

# --- Misc ------------------------------------------------------------------------
LOG_LEVEL=INFO
# Where uploads, the index, the registry and UI-saved settings are stored
# (default ./data). On a cloud host this MUST be a persistent volume, or all
# documents and the index are lost on every restart/redeploy.
# DATA_DIR=./data
# Development only: where the Vite dev server (npm run dev in web/) proxies /api to.
# DOCMIND_API_URL=http://127.0.0.1:8000
# Where the built UI is served from (default ./web/dist; served by the API if present).
# WEB_DIST_DIR=./web/dist
# Build-time, web UI only (set in the environment of `npm run build`, not here):
# VITE_API_BASE_URL=https://api.example.com  - only if the UI is hosted on a
# different origin from the API. Public value; never put secrets in VITE_*.
